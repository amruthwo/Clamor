{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clamor",
  "version": "0.4.0",
  "identifier": "io.github.amruthwo.Clamor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clamor",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "dmg", "nsis"],
    "category": "Utility",
    "shortDescription": "Pool the idle computers on your network to run local AI models",
    "longDescription": "Clamor lets the computers and phones in your home team up to run AI models too big for any one of them. This app starts or joins a swarm and shows its dashboard.",
    "copyright": "GPL-3.0-or-later",
    "externalBin": ["binaries/clamor-node"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    }
  }
}
